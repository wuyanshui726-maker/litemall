<!-- 分类页：左栏食物/饮品tab + 右栏商品两列网格 -->
<view class="container">
  <!-- 左栏固定tab -->
  <view class="cate-nav">
    <view wx:for="{{navList}}" wx:key="id"
          class="nav-item {{ id == item.id ? 'active' : ''}}"
          data-id="{{item.id}}" bindtap="switchCate">
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 右栏滚动商品列表 -->
  <scroll-view scroll-y="true" class="goods-area">
    <view class="goods-grid">
      <navigator class="goods-item" url="/pages/goods/goods?id={{iitem.id}}"
                wx:for="{{goodsList}}" wx:key="id" wx:for-item="iitem">
        <image class="img" src="{{iitem.picUrl}}" mode="aspectFill"></image>
        <view class="name">{{iitem.name}}</view>
        <view class="price">￥{{iitem.retailPrice}}</view>
      </navigator>
      <view wx:if="{{goodsList.length === 0}}" class="empty">该分类暂无商品</view>
    </view>
  </scroll-view>
</view>
