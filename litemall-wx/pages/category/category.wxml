<view class="container">
  <!-- 批发改造：上面只有2个分类 tab -->
  <view class="cate-nav">
    <view wx:for="{{navList}}" class="item {{ id == item.id ? 'active' : ''}}" wx:key="id" data-id="{{item.id}}" bindtap="switchCate">
      <view class="name">{{item.name}}</view>
    </view>
  </view>

  <!-- 批发改造：下面直接商品列表，左右两列 -->
  <scroll-view scroll-y="true" scroll-top="{{scrollTop}}" style="height:{{scrollHeight}}px;">
    <view class="goods-grid">
      <navigator class="goods-item" url="/pages/goods/goods?id={{iitem.id}}" wx:for="{{goodsList}}" wx:key="id" wx:for-item="iitem" wx:for-index="iindex">
        <image class="img" src="{{iitem.picUrl}}" mode="aspectFill"></image>
        <text class="name">{{iitem.name}}</text>
        <text class="price">￥{{iitem.retailPrice}}</text>
      </navigator>
      <view wx:if="{{goodsList.length === 0}}" class="empty-tip">
        <text>该分类暂无商品</text>
      </view>
    </view>
  </scroll-view>
</view>
