/* 正确的分类页样式：pages/catalog/catalog */
page {
  height: 100%;
  background: #f9f9f9;
}

.container {
  background: #f9f9f9;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部搜索 ===== */
.search {
  height: 88rpx;
  width: 100%;
  padding: 0 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.search .input {
  width: 690rpx;
  height: 56rpx;
  background: #ededed;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search .txt {
  height: 42rpx;
  line-height: 42rpx;
  color: #666;
  padding-left: 10rpx;
  font-size: 30rpx;
}

/* ===== 主体：左栏 + 右栏 ===== */
.catalog {
  flex: 1;
  width: 100%;
  background: #fff;
  display: flex;
  border-top: 1px solid #fafafa;
  overflow: hidden;
}

/* ===== 左栏 tab ===== */
.catalog .nav {
  width: 162rpx;
  background: #f5f5f5;
}

.catalog .nav .item {
  text-align: center;
  line-height: 90rpx;
  width: 162rpx;
  height: 90rpx;
  color: #333;
  font-size: 28rpx;
  border-left: 6rpx solid #f5f5f5;
  background: #f5f5f5;
}

.catalog .nav .item.active {
  color: #ab956d;
  font-size: 36rpx;
  font-weight: bold;
  border-left: 6rpx solid #ab956d;
  background: #fff;
}

/* ===== 右栏商品 ===== */
.catalog .cate {
  border-left: 1px solid #fafafa;
  flex: 1;
  padding: 16rpx;
  box-sizing: border-box;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-item {
  width: 48%;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
}

.goods-item .img {
  width: 100%;
  height: 280rpx;
  background: #f8f8f8;
}

.goods-item .name {
  font-size: 24rpx;
  color: #333;
  padding: 12rpx 16rpx 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-item .price {
  font-size: 26rpx;
  color: #e64340;
  font-weight: bold;
  padding: 4rpx 16rpx 16rpx;
  display: block;
}

.empty {
  width: 100%;
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
