page {
  height: 100%;
  width: 100%;
  background: #f4f4f4;
}

.container {
  background: #f4f4f4;
  width: 100%;
  padding-bottom: 60rpx;
}

/* ===== 顶部用户信息 ===== */
.profile-info {
  background-color: #ab956d;
  color: #fff;
  display: flex;
  align-items: center;
  padding: 60rpx 30rpx;
}

.profile-info .avatar {
  height: 120rpx;
  width: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  flex-shrink: 0;
}

.profile-info .info {
  flex: 1;
  padding-left: 30rpx;
}

.profile-info .name {
  font-size: 36rpx;
  color: #fff;
}

/* ===== 菜单列表 ===== */
.menu-list {
  background: #fff;
  margin-top: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 30rpx;
  background: #fff;
  border: none;
  text-align: left;
  width: 100%;
  box-sizing: border-box;
}

.menu-btn {
  padding: 0;
  margin: 0;
  line-height: normal;
}

.menu-btn::after {
  border: none;
}

/* ===== 统一图标 ===== */
.menu-item .icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

/* ===== 统一文字 ===== */
.menu-item .label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-item .arrow {
  color: #ccc;
  font-size: 28rpx;
  margin-left: auto;
}

/* ===== badge ===== */
.menu-item .badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  background: #e64340;
  color: #fff;
  border-radius: 16rpx;
  font-size: 20rpx;
  text-align: center;
  padding: 0 6rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-left: 102rpx; /* 48 icon + 24 margin + 30 padding */
}

/* ===== 退出登录 ===== */
.logout {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  text-align: center;
  color: #666;
  font-size: 28rpx;
}
