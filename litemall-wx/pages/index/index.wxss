/* 批发改造：首页新样式 */
page { background: #f5f5f5; }

.container {
  padding: 20rpx;
}

/* 搜索栏 */
.search {
  margin-bottom: 20rpx;
}
.search .input {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.search .input .txt {
  margin-left: 12rpx;
  color: #999;
  font-size: 28rpx;
}

/* 操作指南区 */
.guide-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.title-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.guide-content {
  min-height: 300rpx;
}

.guide-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #bbb;
}
.ph-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.ph-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.ph-sub {
  font-size: 24rpx;
  color: #ccc;
}

/* 快捷入口 */
.quick-entry {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.entry-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.entry-text {
  font-size: 26rpx;
  color: #555;
}