<!-- index.wxml - 批发版首页 -->
<view class="container">
    <!-- 搜索栏 -->
    <view class="search">
        <navigator url="/pages/search/search" class="input">
            <van-icon name="search" />
            <text class="txt">商品搜索</text>
        </navigator>
    </view>

    <!-- 批发改造：零售操作指南（占位，后续慢慢写） -->
    <view class="guide-section">
        <view class="section-title">
            <text class="title-icon">📋</text>
            <text class="title-text">零售操作指南</text>
        </view>

        <view class="guide-content">
            <view class="guide-placeholder">
                <view class="ph-icon">📝</view>
                <view class="ph-text">操作指南内容待补充</view>
                <view class="ph-sub">（如何下单、如何查看订单、联系方式等）</view>
            </view>
        </view>
    </view>

    <!-- 批发改造：快捷入口 -->
    <view class="quick-entry">
        <navigator class="entry-item" url="/pages/category/category">
            <view class="entry-icon">🛒</view>
            <text class="entry-text">浏览商品</text>
        </navigator>
        <navigator class="entry-item" url="/pages/ucenter/ucenter">
            <view class="entry-icon">📦</view>
            <text class="entry-text">我的订单</text>
        </navigator>
        <navigator class="entry-item" url="/pages/cart/cart">
            <view class="entry-icon">🛍️</view>
            <text class="entry-text">购物车</text>
        </navigator>
    </view>
</view>
