/* 批发改造：分类页 - 左栏 + 右商品网格布局 */
.container {
  display: flex;
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
}

/* 左栏 */
.cate-nav {
  width: 180rpx;
  background: #fff;
  flex-shrink: 0;
  border-right: 1rpx solid #eee;
}

.cate-nav-body {
  width: 180rpx;
}

.cate-nav .item {
  padding: 30rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.cate-nav .item.active {
  color: #e64340;
  font-weight: bold;
  background: #f5f5f5;
}

.cate-nav .item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 6rpx;
  background: #e64340;
  border-radius: 0 3rpx 3rpx 0;
}

/* 右商品区域 */
.goods-area {
  flex: 1;
  padding: 20rpx;
  overflow: hidden;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.goods-item {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
}

.goods-item .img {
  width: 100%;
  height: 280rpx;
  background: #f8f8f8;
}

.goods-item .name {
  font-size: 26rpx;
  color: #333;
  padding: 12rpx 16rpx 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-item .price {
  font-size: 28rpx;
  color: #e64340;
  font-weight: bold;
  padding: 4rpx 16rpx 16rpx;
}

.empty-tip {
  width: 100%;
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}