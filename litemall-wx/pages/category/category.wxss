/* 批发改造：分类页 - 上下布局（上 tab + 下商品网格） */
.container {
  width: 100%;
  background: #f5f5f5;
}

/* 顶部分类 tab 栏 */
.cate-nav {
  display: flex;
  width: 100%;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  padding: 0 40rpx;
}

.cate-nav .item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.cate-nav .item.active {
  color: #e64340;
  font-weight: bold;
}

.cate-nav .item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #e64340;
  border-radius: 3rpx;
}

/* 商品网格 - 两列 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  gap: 20rpx;
  background: #f5f5f5;
}

.goods-item {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.goods-item .img {
  width: 100%;
  height: 320rpx;
  background: #f8f8f8;
}

.goods-item .name {
  font-size: 26rpx;
  color: #333;
  padding: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-item .price {
  font-size: 30rpx;
  color: #e64340;
  font-weight: bold;
  padding: 0 16rpx 20rpx;
}

.empty-tip {
  width: 100%;
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
