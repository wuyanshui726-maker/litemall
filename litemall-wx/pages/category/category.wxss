/* 分类页：左栏tab + 右栏商品（参照用户参考图） */
.container {
  display: flex;
  height: 100vh;
  overflow: hidden;
  background: #f5f5f5;
}

/* ===== 左栏固定tab ===== */
.cate-nav {
  width: 170rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.nav-item {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-left: 6rpx solid transparent;
  position: relative;
}

.nav-item.active {
  background: #fff;
  color: #e64340;
  font-weight: bold;
  border-left-color: #e64340;
}

/* ===== 右栏商品网格 ===== */
.goods-area {
  flex: 1;
  height: 100vh;
  background: #fff;
  padding: 16rpx;
  box-sizing: border-box;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-item {
  width: 48%;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
}

.goods-item .img {
  width: 100%;
  height: 280rpx;
  background: #f8f8f8;
}

.goods-item .name {
  font-size: 24rpx;
  color: #333;
  padding: 12rpx 16rpx 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-item .price {
  font-size: 26rpx;
  color: #e64340;
  font-weight: bold;
  padding: 4rpx 16rpx 16rpx;
}

.empty {
  width: 100%;
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
